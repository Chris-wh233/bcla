# Copy to deploy.env on the remote host. This is a trusted Bash configuration file.
BCLA_IMAGE=bcla-remote:local
BCLA_CONTAINER=bcla-remote
# Omit to use the deploying user's ~/.local/share/bcla.
# Must be a local, absolute path after expansion; SQLite needs local locking.
# BCLA_DATA_DIR=/srv/bcla
# Optional base override; the default Dockerfile digest is verified Linux/LoongArch64.
# BCLA_BASE_IMAGE=lcr.loongnix.cn/library/debian:forky@sha256:...
